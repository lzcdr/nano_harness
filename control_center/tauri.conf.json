{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nano_harness control center",
  "version": "0.1.0",
  "identifier": "com.nanoharness.controlcenter",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NANO_HARNESS // CONTROL CONSOLE",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
